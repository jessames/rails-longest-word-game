<!DOCTYPE html>
<html>
  <head>
    <title>RailsFirstApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <h1>New game</h1>
    <ul style="list-style: none; display: flex; padding: 0; text-decoration-style: none;">
      <% @letters.each do |letter| %>
        <li style="background-color: blue; padding: 20px; margin-right: 20px; color: #fff; width: 20px; font-weight: 900"><%= letter.capitalize %></li>
      <% end %>
    </ul>

    <form action="score" method="post" data-turbo="false">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <div><label for="word">What is the longest word you can find?</label></div>
      <input type="text" id="question" name="question">
      <input type="submit" value="Play!">
    </form>

  </body>
</html>
